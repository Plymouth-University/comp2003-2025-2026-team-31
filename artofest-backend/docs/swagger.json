{
  "openapi": "3.0.0",
  "info": {
    "title": "ArtOfest API",
    "version": "1.0.0",
    "description": "API for exploring festivals, managing user wishlists, and streaming festival content."
  },
  "servers": [
    {
      "url": "https://artofest-api-yc0q.onrender.com"
    }
  ],
  "tags": [
    { "name": "Festivals" },
    { "name": "Auth" },
    { "name": "Wishlist" },
    { "name": "Streams" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Festival": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "city": { "type": "string" },
          "country": { "type": "string" },
          "image_url": { "type": "string" },
          "website": { "type": "string" },
          "festival_images": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },

      "CreateFestivalRequest": {
        "type": "object",
        "required": ["name", "city", "country", "art_form"],
        "properties": {
          "name": { "type": "string" },
          "city": { "type": "string" },
          "country": { "type": "string" },
          "website": { "type": "string" },
          "art_form": { "type": "string" },
          "genres": {
            "type": "array",
            "items": { "type": "string" }
          },
          "images": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },

      "UpdateFestivalRequest": {
        "allOf": [
          { "$ref": "#/components/schemas/CreateFestivalRequest" }
        ]
      },

      "RegisterRequest": {
        "type": "object",
        "required": ["username", "email", "password"],
        "properties": {
          "username": { "type": "string" },
          "email": { "type": "string" },
          "password": { "type": "string" }
        }
      },

      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string" },
          "password": { "type": "string" }
        }
      },

      "WishlistItem": {
        "type": "object",
        "properties": {
          "profile_id": { "type": "integer" },
          "festival_id": { "type": "integer" },
          "festival_name": { "type": "string" },
          "country": { "type": "string" },
          "image_url": { "type": "string" },
          "website": { "type": "string" }
        }
      },

      "Stream": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "url": { "type": "string" },
          "platform": { "type": "string" }
        }
      },

      "CategoryGroup": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "streams": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Stream"
            }
          }
        }
      },

      "StreamGroup": {
        "type": "object",
        "properties": {
          "festival_id": { "type": "integer" },
          "festival_name": { "type": "string" },
          "categories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CategoryGroup"
            }
          }
        }
      },

      "CreateStreamsRequest": {
        "type": "object",
        "required": ["festival_id", "streams"],
        "properties": {
          "festival_id": { "type": "integer" },
          "streams": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["title", "url", "platform", "category_id"],
              "properties": {
                "title": { "type": "string" },
                "url": { "type": "string" },
                "platform": { "type": "string" },
                "category_id": { "type": "integer" }
              }
            }
          }
        }
      },

      "UpdateStreamRequest": {
        "type": "object",
        "required": ["title", "url", "platform", "category_id"],
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string" },
          "platform": { "type": "string" },
          "category_id": { "type": "integer" }
        }
      }
    }
  },

  "paths": {
    "/api/festivals": {
      "get": {
        "summary": "Get all festivals",
        "tags": ["Festivals"],
        "responses": {
          "200": {
            "description": "List of festivals",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Festival" }
                }
              }
            }
          }
        }
      }
    },

    "/api/festivals/{id}": {
      "get": {
        "summary": "Get festival by ID",
        "tags": ["Festivals"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Festival details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Festival" }
              }
            }
          }
        }
      }
    },

    "/api/festivals/admin": {
      "post": {
        "summary": "Create festival (Admin only)",
        "tags": ["Festivals"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateFestivalRequest" }
            }
          }
        },
        "responses": {
          "201": { "description": "Festival created" }
        }
      }
    },

    "/api/festivals/admin/{id}": {
      "put": {
        "summary": "Update festival (Admin only)",
        "tags": ["Festivals"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateFestivalRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Festival updated" }
        }
      },
      "delete": {
        "summary": "Delete festival (Admin only)",
        "tags": ["Festivals"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": { "description": "Festival deleted" }
        }
      }
    },

    "/api/streams": {
      "get": {
        "summary": "Get all streams grouped by festival",
        "tags": ["Streams"],
        "responses": {
          "200": {
            "description": "Stream groups",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/StreamGroup"
                  }
                }
              }
            }
          }
        }
      }
    },

    "/api/streams/{festivalId}": {
      "get": {
        "summary": "Get streams by festival ID",
        "tags": ["Streams"],
        "parameters": [
          {
            "name": "festivalId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Streams",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StreamGroup"
                }
              }
            }
          }
        }
      }
    },

    "/api/streams/admin": {
      "post": {
        "summary": "Create streams (Admin only)",
        "tags": ["Streams"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateStreamsRequest"
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Streams created" }
        }
      }
    },

    "/api/streams/admin/{id}": {
      "put": {
        "summary": "Update stream (Admin only)",
        "tags": ["Streams"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateStreamRequest"
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Stream updated" }
        }
      },
      "delete": {
        "summary": "Delete stream (Admin only)",
        "tags": ["Streams"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": { "description": "Stream deleted" }
        }
      }
    }
  }
}